# local: browser localStorage. feishu: local/hosted Node backend + Feishu Bitable.
VITE_DATA_SOURCE=feishu
VITE_API_BASE_URL=/api

# Server.
PORT=8787
# Local dev can keep localhost. For split frontend/backend deployment, set this to the public frontend URL.
# Multiple origins can be comma-separated.
CORS_ORIGIN=http://localhost:5173

# Feishu Bitable integration.
# Keep these values on the Node backend. The frontend should never receive FEISHU_APP_SECRET.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BASE_APP_TOKEN=
VEHICLE_TABLE_ID=
SPECS_TABLE_ID=
BENCHMARK_TABLE_ID=
MEDIA_TABLE_ID=
DISCUSSION_TABLE_ID=
VERSION_TABLE_ID=
