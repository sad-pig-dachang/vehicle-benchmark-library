# local: browser localStorage. feishu: local/hosted Node backend + Feishu Bitable.
VITE_DATA_SOURCE=feishu
VITE_API_BASE_URL=/api

# Server.
PORT=8787
# Local dev can keep localhost. Public read-only deployments can use *.
# Multiple origins can be comma-separated.
CORS_ORIGIN=*
# Public website is read-only by default. Keep false unless this is a private admin deployment.
ALLOW_WRITES=false

# Feishu Bitable integration.
# Keep these values on the Node backend. The frontend should never receive FEISHU_APP_SECRET.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Standalone /base/ URL: fill BASE_APP_TOKEN. Wiki URL: fill WIKI_NODE_TOKEN instead.
BASE_APP_TOKEN=
WIKI_NODE_TOKEN=

# Optional table ID fallbacks. The backend prefers Chinese table names automatically.
# Main required table name candidates: 档案基础信息1, 档案基础信息.
# Optional detail table name candidates: L1-L5 tables with or without the trailing "1".
VEHICLE_TABLE_ID=
SPECS_TABLE_ID=
BENCHMARK_TABLE_ID=
MEDIA_TABLE_ID=
DISCUSSION_TABLE_ID=
VERSION_TABLE_ID=
